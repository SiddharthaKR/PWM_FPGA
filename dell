%% ted_openloop_eye.m
%  Open-loop MM S-curve + eye for a 6-bit ADC capture (OSR=2), built on YOUR
%  loop structure and ONE interpolator (your interpsinc kernel) used everywhere.
%
%  Open loop = your loop with the tau-update FROZEN, outputting the error term
%  while tau is stepped by hand. Same interpolator drives the closed-loop check,
%  so the two cannot disagree.
%
%    tau_opt  : forced tau of max output power        = true optimum (eye centre)
%    tau_star : S-curve zero-crossing NEAREST tau_opt = the TED null that matters
%    bias     : tau_opt - tau_star
%  Feedback sign is derived from the S-curve slope so the loop locks to tau_star.
% ------------------------------------------------------------------------
clear; clc; close all;

%% ---------------- CONFIG ----------------
cfg.file   = 'adc_data.txt';  % one 6-bit unsigned value per line (0..63)
cfg.OSR    = 2;               % ADC samples per symbol (= m)
cfg.coding = 'offset';        % '6-bit coding: 'offset' (midscale 32) or 'signed'
cfg.Ntap   = 48;              % sinc taps
cfg.Nph    = 128;             % forced-tau points across one UI (resolution only)
cfg.mu     = 0.01;            % closed-loop gain (set to your loop's value)

%% ---------------- LOAD + CONVERT ----------------
raw = load(cfg.file);  raw = raw(:);
switch lower(cfg.coding)
    case 'offset',  x = (double(raw) - 32) / 32;
    case 'signed',  x =  double(raw) / 32;
    otherwise, error('cfg.coding must be ''offset'' or ''signed''');
end
m = cfg.OSR;  N = cfg.Ntap;  R = numel(x);
Nb   = floor((R - 2*N)/m);            % usable baud samples (N margin each end)
base = (1 + N + (0:Nb-1)*m).';        % baud base indices (integer sampling instants)
fprintf('Loaded %d samples (%d usable symbols, OSR=%d)\n', R, Nb, m);

%% ---------------- OPEN-LOOP: FROZEN-tau SWEEP ----------------
tau_sweep = (0:cfg.Nph-1).'/cfg.Nph;
S = zeros(cfg.Nph,1); P = zeros(cfg.Nph,1); Amp = zeros(cfg.Nph, Nb);
for s = 1:cfg.Nph
    yb = interpsinc_eval(x, base + tau_sweep(s)*m, N);   % baud samples at this tau
    a  = sign(yb); a(a==0)=1;
    e  = a(2:end).*yb(1:end-1) - a(1:end-1).*yb(2:end);  % MM error (frozen output)
    S(s) = mean(e);  P(s) = mean(yb.^2);  Amp(s,:) = yb.';
end
[~,iOpt] = max(P);  tau_opt = tau_sweep(iOpt);

% tau_star = zero-crossing nearest tau_opt (ignores noisy near-zero wiggles)
Sx=[S; S(1)]; px=[tau_sweep;1]; zc=[];
for i=1:numel(Sx)-1
    if sign(Sx(i))~=sign(Sx(i+1)) && Sx(i)~=Sx(i+1)
        f=-Sx(i)/(Sx(i+1)-Sx(i)); zc(end+1,1)=mod(px(i)+f*(px(i+1)-px(i)),1); %#ok<SAGROW>
    end
end
[~,jz]  = min(abs(mod(zc-tau_opt+0.5,1)-0.5));
tau_star = zc(jz);
bias = mod(tau_opt - tau_star + 0.5,1)-0.5;

% feedback sign so the loop is stable AT tau_star (locks to the eye centre)
i0 = mod(round(tau_star*cfg.Nph),cfg.Nph); if i0==0, i0=cfg.Nph; end
slope = S(mod(i0,cfg.Nph)+1) - S(mod(i0-2,cfg.Nph)+1);
loopsign = -sign(slope);

fprintf('\n--- OPEN-LOOP (absolute, this record) ---\n');
fprintf('  tau_opt  (max output power)      : %.4f UI\n', tau_opt);
fprintf('  crossings found                  : %s UI\n', mat2str(round(zc.',3)));
fprintf('  tau_star (nearest tau_opt)       : %.4f UI  (slope %+0.4f)\n', tau_star, slope);
fprintf('  bias = tau_opt - tau_star        : %+.4f UI\n', bias);

%% ---------------- CLOSED-LOOP CROSS-CHECK (same interpolator) ----------------
tau=0; yprev=0; aprev=1; tnow=1+N; tausave=zeros(Nb,1);
for k=1:Nb
    xs  = interpsinc_eval(x, tnow + tau*m, N);   % your interpsinc, single point
    a   = sign(xs); if a==0, a=1; end
    e   = a*yprev - aprev*xs;                     % MM error
    tau = tau + loopsign*cfg.mu*e;                % sign chosen from S-curve slope
    tnow= tnow + m;
    tausave(k)=mod(tau,1); yprev=xs; aprev=a;
end
tau_cl = mod(mean(tausave(round(0.7*Nb):end)),1);
fprintf('\n--- CLOSED-LOOP CROSS-CHECK ---\n');
fprintf('  feedback sign used               : %+0.0f  (tau = tau %s mu*e)\n', loopsign, char('+'*(loopsign>0)+'-'*(loopsign<0)));
fprintf('  converged tau (mod 1 UI)         : %.4f UI\n', tau_cl);
fprintf('  delta vs tau_star                : %+.4f UI\n', mod(tau_cl-tau_star+0.5,1)-0.5);

%% ---------------- PLOTS ----------------
figure('Name','TED diagnostics','Color','w','Position',[80 80 1150 820]);
subplot(2,2,1);
  plot(tau_sweep,S,'b-','LineWidth',1.3); hold on; grid on; yline(0,'k:');
  xline(tau_star,'r--',sprintf('\\tau^*=%.3f',tau_star));
  xlabel('forced \tau [UI]'); ylabel('mean MM error'); title('Open-loop S-curve');
subplot(2,2,2);
  plot(tau_sweep,P/max(P),'b-','LineWidth',1.3); hold on; grid on;
  xline(tau_opt,'r--',sprintf('\\tau_{opt}=%.3f',tau_opt));
  xlabel('forced \tau [UI]'); ylabel('norm. output power'); title('Output power vs \tau');
subplot(2,2,3);
  Ksh=min(400,Nb-1); tt=[tau_sweep; tau_sweep+1];
  plot(tt,[Amp(:,1:Ksh); Amp(:,2:Ksh+1)],'Color',[0 0.3 0.7 0.10]); grid on;
  xline(tau_opt,'r--'); xline(tau_opt+1,'r--');
  xlabel('\tau [UI]'); ylabel('amp'); title('Eye (from the sweep)');
subplot(2,2,4);
  plot(tausave,'b-'); grid on; yline(tau_star,'r--');
  xlabel('symbol'); ylabel('NCO \tau [UI]'); title('Closed-loop \tau (mod 1 UI)');

%% ======================= LOCAL FUNCTIONS =======================
function y = interpsinc(x, tau, fu, resample_taplength, resample_length)
% -------- YOUR FUNCTION, UNCHANGED (reference) --------
% Needs >= taplength/2 history in x so idx>=1 (true inside your loop). For a
% standalone record the runnable equivalent is interpsinc_eval below.
    sinc_mat = (tau*fu - (-resample_taplength/2 : resample_taplength/2-1)).';
    y = zeros(resample_length,1);
    for i = 1:resample_length
        idx    = ((i-1) + (-resample_taplength/2 : resample_taplength/2-1)).';
        y(i,1) = sum( x(idx) .* sinc(sinc_mat) );
    end
end

function y = interpsinc_eval(x, pos, N)
% THE single interpolator: your interpsinc sinc kernel evaluated at continuous
% positions pos (1-based), edge-clamped. Same kernel sinc(mu - k) over an
% N-tap window; used for BOTH the frozen sweep and the closed loop.
    x = x(:); Lx = numel(x); pos = pos(:);
    k = (-N/2 : N/2-1);
    y = zeros(numel(pos),1);
    for j = 1:numel(pos)
        n0 = floor(pos(j)); mu = pos(j) - n0;
        idx = min(max(n0 + k, 1), Lx);
        y(j) = sum( x(idx) .* sinc(mu - k) );
    end
end
