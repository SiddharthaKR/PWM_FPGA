PART E - DIAGNOSTIC COMMAND REFERENCE
=====================================================================================
Linux
  lsusb | grep -i 0403                     FTDI USB-JTAG/UART present
  ls /dev/ttyUSB*                          serial ports
  dmesg | tail -20                         USB plug events / errors
  pkill hw_server ; hw_server &            restart hardware server

xsdb  (start: source <Vitis>/settings64.sh ; xsdb ; connect)
  targets                                  list processors / PL / state
  jtag targets                             raw JTAG chain
  jtag frequency 5000000                   slower JTAG (after jtag targets -set N)
  fpga -state                              is the PL configured?
  targets -set -nocase -filter {name =~ "*A53*#0"}
  state                                    Running / Stopped
  stop ; bt ; con                          where is the CPU (backtrace), resume
  rst -system                              full reset (Vivado then loses the ILA)
  source boot.tcl                          full boot again
  disconnect ; exit

Vivado Tcl console
  open_hw_manager
  connect_hw_server -url localhost:3121
  open_hw_target
  get_hw_devices                           expect xczu48dr_0 and arm_dap_1
  report_property [get_hw_devices xczu48dr_0]       device state, probes file, etc.
  refresh_hw_device [get_hw_devices xczu48dr_0]     re-scan debug cores
  get_hw_ilas ; get_hw_vios                expect hw_ila_1 (and hw_vio_1)
  get_hw_probes -of_objects [get_hw_ilas hw_ila_1]  list probe names
  run_hw_ila -trigger_now [get_hw_ilas hw_ila_1]
  wait_on_hw_ila [get_hw_ilas hw_ila_1]
  display_hw_ila_data [upload_hw_ila_data [get_hw_ilas hw_ila_1]]
  write_hw_ila_data -force -csv_file ~/zcu208_dds_ila/cap.csv \
        [upload_hw_ila_data [get_hw_ilas hw_ila_1]]  save capture as CSV
  close_hw_target ; disconnect_hw_server ; close_hw_manager


=====================================================================================
PART F - FALLBACK BOOT WITHOUT FSBL (if D3 cannot be fixed)
=====================================================================================
Uses psu_init.tcl from the XSA instead of the FSBL.

  cd ~/zcu208_dds_ila
  unzip -o design_1_wrapper.xsa psu_init.tcl     # extract PS init script from XSA
  ls psu_init.tcl

cat > ~/zcu208_dds_ila/boot_psuinit.tcl <<'EOF'
set here [file dirname [file normalize [info script]]]
connect
targets -set -nocase -filter {name =~ "*PSU*"}
rst -system
after 3000
fpga -file $here/design_1_wrapper.bit
puts [fpga -state]
targets -set -nocase -filter {name =~ "*PSU*"}
source $here/psu_init.tcl
psu_init
after 1000
psu_ps_pl_isolation_removal
after 1000
psu_ps_pl_reset_config
catch {psu_protection}
targets -set -nocase -filter {name =~ "*A53*#0"}
rst -processor
dow $here/RFSOC.elf
con
puts "Done - application is running (psu_init flow)"
disconnect
EOF

Run:  xsdb boot_psuinit.tcl    then continue with C4.


